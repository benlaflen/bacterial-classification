# profile.conf — configuration for profile_remote.sh
# Copy this to your project root and fill in your values.
# Pass it with: ./profile_remote.sh --config profile.conf
#
# Lines beginning with # are comments.
# Values do NOT need to be quoted (quotes are stripped automatically).
# Inline comments after values are also stripped.

# ---- SSH connection --------------------------------------------------------
HOST=seelab-cuda-2.ucsd.edu                   # hostname or IP of your remote server
USER=zebra                           # your SSH username
PORT=42118                              # SSH port (default 22)

# ---- Repository & build ----------------------------------------------------
REPO_PATH=/home/zebra/blaflen/bacteria/bacterial-classification     # absolute path to repo root on server
BUILD_DIR=build_profile              # subdirectory inside repo for this profile build
BRANCH=                              # git branch to checkout (blank = stay on current)

# ---- Binary & arguments ----------------------------------------------------
BINARY=tests/sim-test                  # path to binary RELATIVE to BUILD_DIR
ARGS=                # arguments passed to the binary (one string)

# ---- CMake -----------------------------------------------------------------
CMAKE_EXTRA_ARGS=-DCMAKE_CXX_FLAGS=-mavx2      # any extra -D flags to pass to cmake

# ---- Output ----------------------------------------------------------------
OUTPUT_DIR=./profile_output          # local directory for all results

# ---- Annotation formatting -------------------------------------------------
COL_WIDTH=45                         # total width of the annotation prefix column
HOT_THRESHOLD=1.0                    # lines using >= this % get a * marker

# ---- Toggle profilers ------------------------------------------------------
# Uncomment to disable a profiler:
# NO_GPU=1
# NO_CPU=1